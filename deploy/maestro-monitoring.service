[Unit]
Description=Maestro hosted-pool healthcheck + OAuth reminder emails
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/maestro/backend
EnvironmentFile=/etc/maestro/env
ExecStart=/opt/maestro/.venv/bin/python -m maestro.monitoring
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maestro-monitoring
