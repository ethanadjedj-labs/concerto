[Unit]
Description=Maestro Backend API (FastAPI/uvicorn, port 8090)
After=network.target
After=cortex-mcp-bridge.service

[Service]
User=root
Restart=always
RestartSec=5
WorkingDirectory=/opt/maestro/backend
Environment="MAESTRO_DB_PATH=/var/lib/maestro/maestro.db"
EnvironmentFile=-/etc/cortex/env
ExecStart=/opt/maestro/backend/.venv/bin/uvicorn \
    maestro.server:app \
    --host 127.0.0.1 \
    --port 8090 \
    --workers 2

[Install]
WantedBy=multi-user.target
