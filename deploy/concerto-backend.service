[Unit]
Description=Concerto Backend API (FastAPI/uvicorn, port 8090)
After=network.target
After=cortex-mcp-bridge.service

[Service]
User=root
Restart=always
RestartSec=5
WorkingDirectory=/opt/concerto/backend
Environment="CONCERTO_DB_PATH=/var/lib/concerto/concerto.db"
EnvironmentFile=-/etc/cortex/env
ExecStart=/opt/concerto/backend/.venv/bin/uvicorn \
    concerto.server:app \
    --host 127.0.0.1 \
    --port 8090 \
    --workers 2

[Install]
WantedBy=multi-user.target
