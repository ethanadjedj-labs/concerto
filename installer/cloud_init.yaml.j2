#cloud-config
# Maestro droplet bootstrap — stub (feat/installer-v1 will replace this)
package_update: true

packages:
  - curl
  - wget
  - jq
  - git
  - unzip

runcmd:
  # Install authorized SSH key injected at provision time
  - mkdir -p /root/.ssh && chmod 700 /root/.ssh
  - echo "{{ ssh_public_key }}" >> /root/.ssh/authorized_keys
  - chmod 600 /root/.ssh/authorized_keys

  # Install ttyd (web terminal) and start on localhost only
  - |
    TTYD_VER=$(curl -sf https://api.github.com/repos/tsl0922/ttyd/releases/latest \
      | jq -r '.tag_name' 2>/dev/null || echo "1.7.4")
    wget -qO /usr/local/bin/ttyd \
      "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VER}/ttyd.x86_64"
    chmod +x /usr/local/bin/ttyd
  - |
    cat > /etc/systemd/system/ttyd.service <<'EOF'
    [Unit]
    Description=ttyd web terminal
    After=network.target

    [Service]
    ExecStart=/usr/local/bin/ttyd --port 7681 --interface 127.0.0.1 bash
    Restart=always
    RestartSec=5

    [Install]
    WantedBy=multi-user.target
    EOF
    systemctl daemon-reload
    systemctl enable --now ttyd

  # Ping Maestro API when installation is complete
  - |
    sleep 20
    BEARER="$(head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 32)"
    curl -sf -X POST {{ maestro_api_base }}/api/internal/droplet-ready \
      -H 'Content-Type: application/json' \
      -d "{\"token\":\"{{ token }}\",\"mcp_url\":\"stub://pending\",\"bearer_token\":\"${BEARER}\"}" \
      || echo "[maestro] pingback failed — will retry manually"
