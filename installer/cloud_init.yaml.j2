#cloud-config
# Concerto installer - Jinja2 template rendered by the empire backend.
#
# Template variables (all required):
#   concerto_token        - per-provisioning callback token (identifies this droplet)
#   concerto_callback_url - backend webhook URL to POST the tunnel/bearer details to
#   ssh_authorized_key   - backend-generated public key for terminal proxy access
#   customer_email       - customer email for audit logs
#   ttyd_password        - random 32-char hex credential for ttyd Basic Auth (F2)
#   concerto_token_prefix - first 8 chars of bearer_token (display only)
#
# Rendered YAML is injected into DigitalOcean Droplet user-data at provision time.
# cloud-init runs runcmd on first boot as root.

# --- SSH ---------------------------------------------------------------------
# F4: ssh_authorized_keys is processed by cloud-init BEFORE runcmd executes,
# guaranteeing the key is in place before any service starts.

ssh_authorized_keys:
  - "{{ ssh_authorized_key }}"

# --- Write files (before runcmd) ---------------------------------------------

write_files:

  # Concerto environment - callback URL and provisioning identity
  - path: /etc/concerto/env
    owner: root:root
    permissions: '0600'
    content: |
      CONCERTO_CALLBACK_URL={{ concerto_callback_url }}
      CONCERTO_TOKEN={{ concerto_token }}
      CUSTOMER_EMAIL={{ customer_email }}
      TUNNEL_HOSTNAME={{ tunnel_hostname }}

  # Version stamp
  - path: /etc/concerto/version
    owner: root:root
    permissions: '0644'
    content: "1.0.0\n"

  # F2: ttyd credential file - password is rendered at provision time
  - path: /etc/concerto/ttyd.env
    owner: root:root
    permissions: '0600'
    content: |
      TTYD_PASSWORD={{ ttyd_password }}


  # -- concerto-workspace base files --------------------------------------------
  # These are seeded onto the customer VPS at /opt/concerto-workspace/.
  # {{ customer_email }} and {{ concerto_token_prefix }} are Jinja2-rendered at provision time.

  - path: /opt/concerto-workspace/OPS/MANAGER_STATE.md
    owner: root:root
    permissions: '0644'
    content: |
      # Manager State - {{ customer_email }}'s Concerto

      Last updated: <fill on first edit>

      ## Active strategic decisions

      (Write your standing decisions here - what you're building, your business thesis, what you've chosen to ignore.)

      ## Active projects

      (List each active project as a section. When state changes, edit here.)

      ## Pending operator decisions

      (Open questions that block your sessions. Sessions should write here when they can't proceed alone.)

      ## Conventions

      - Sessions read this file before substantive work.
      - Sessions write back here when state changes.
      - This file is your future-self handoff.

  - path: /opt/concerto-workspace/OPS/SESSION_RULES.md
    owner: root:root
    permissions: '0644'
    content: |
      # Session Rules - read at the start of every spawned session

      This file defines binding conventions for Claude Code sessions on your Concerto VPS.

      ## Read first in every session

      1. /opt/concerto-workspace/OPS/MANAGER_STATE.md - strategic state, decisions, follow-ups
      2. /opt/concerto-workspace/OPS/SESSION_RULES.md - this file
      3. /opt/concerto-workspace/OPS/ENVELOPE_SCHEMA.md - return format

      ## Language and communication

      - Write session prompts in English.
      - Include in prompts: goal, deliverables, acceptance criteria, abort conditions.
      - Return envelopes per ENVELOPE_SCHEMA.md as the final stdout output of every session.

      ## Working directory

      - Default working directory: /opt/concerto-workspace/ or a subdirectory.
      - Prefer idempotent operations. Check before writing.

      ## State hygiene

      - When a session changes consequential state, update MANAGER_STATE.md before closing.
      - Keep session scope focused. Flag scope creep and open a separate session.

      ## Resource caveats

      - Concerto VPS: 2 GiB RAM. Max 2 parallel Claude sessions.
      - Abort and report if RAM drops below 200 MiB.

      ## Universal abort triggers

      - VPS RAM below 200 MiB -> stop and report.
      - Auth issues not resolved -> stop and report.
      - Destructive operation not in task spec -> stop and ask.

      ## Output discipline

      - Every session ends by printing its envelope (JSON) to stdout per ENVELOPE_SCHEMA.md.

  - path: /opt/concerto-workspace/OPS/ENVELOPE_SCHEMA.md
    owner: root:root
    permissions: '0644'
    content: |
      # Envelope Schema - final JSON output of every spawned session

      Print this as the FINAL stdout line of every session (single line, no markdown fences):

      {"status":"ok|partial|aborted|failed","summary":"<1-3 sentences>","artifacts":{"files_created":[],"files_modified":[],"pr_url":"","commits":[]},"next_recommended":"<free text>","decisions_for_operator":[],"errors":[]}

      ## Status values

      - ok: all criteria met
      - partial: some criteria met
      - aborted: hit abort trigger
      - failed: unexpected error

  - path: /opt/concerto-workspace/OPS/queue/pending/.gitkeep
    owner: root:root
    permissions: '0644'
    content: ''

  - path: /opt/concerto-workspace/OPS/queue/done/.gitkeep
    owner: root:root
    permissions: '0644'
    content: ''

  - path: /opt/concerto-workspace/OPS/queue/failed/.gitkeep
    owner: root:root
    permissions: '0644'
    content: ''

  - path: /opt/concerto-workspace/README.md
    owner: root:root
    permissions: '0644'
    content: |
      # Your first 5 minutes with Concerto

      Your Concerto VPS is running Claude Code connected to your claude.ai account.

      ## Step 1 - Send your first session

      In any claude.ai conversation with the Concerto connector active:

        Spawn a Concerto session to write a hello world Python script.

      ## Step 2 - Check the session

        List my Concerto sessions.

      ## Step 3 - Pull the output

        What did the hello world session return?

      ## Step 4 - Do real work

      Replace the hello world prompt with something useful. Examples:
      - Spawn a Concerto session to clone my GitHub repo and run the tests.
      - Spawn a Concerto session to set up a Flask app in /opt/concerto-workspace/myapp/.
      - Spawn 3 parallel sessions: audit backend, lint frontend, check deps.

      See examples/parallel_workflow.md for the parallel pattern.

      ## Step 5 - Edit MANAGER_STATE.md

      Write what you're building in OPS/MANAGER_STATE.md.
      Every future session reads this file first.

  - path: /opt/concerto-workspace/examples/sample_prompt.md
    owner: root:root
    permissions: '0644'
    content: |
      # Sample Session Prompt

      Read /opt/concerto-workspace/OPS/MANAGER_STATE.md and /opt/concerto-workspace/OPS/SESSION_RULES.md before starting.

      ## Goal

      <One sentence: what outcome this session should produce.>

      ## Deliverables

      - <Specific file, endpoint, or state change that must exist when done.>

      ## Acceptance criteria

      - <How to verify the work is correct.>

      ## Working directory

      /opt/concerto-workspace/<subdirectory>

      ## Abort conditions

      - If RAM available drops below 200 MiB.
      - If a required credential is missing.
      - If a destructive operation not in this spec would be required.

      ## Return format

      Print a JSON envelope as the final stdout line per /opt/concerto-workspace/OPS/ENVELOPE_SCHEMA.md.

  - path: /opt/concerto-workspace/examples/parallel_workflow.md
    owner: root:root
    permissions: '0644'
    content: |
      # Parallel Workflow

      In one claude.ai message, ask Claude to spawn N sessions simultaneously:

        Spawn 3 Concerto sessions in parallel:
        1. Session "audit-backend": list Python files over 300 lines.
        2. Session "check-deps": run pip list --outdated.
        3. Session "test-suite": run pytest and return pass/fail counts.

      Then collect results:

        What did audit-backend, check-deps, and test-suite return?

      Resource limits: max 2-3 heavy sessions in parallel on a 2 GiB VPS.

  - path: /opt/concerto-workspace/.claude/CLAUDE.md
    owner: root:root
    permissions: '0644'
    content: |
      # Concerto Workspace

      ## Read at the start of every session

      1. OPS/MANAGER_STATE.md - what you are building, active projects, open decisions
      2. OPS/SESSION_RULES.md - conventions for this workspace
      3. OPS/ENVELOPE_SCHEMA.md - how to format your final output

      ## After substantive work

      Update OPS/MANAGER_STATE.md with what changed before closing.

      ## Output discipline

      End every session by printing a JSON envelope to stdout per OPS/ENVELOPE_SCHEMA.md.

  # -- MCP server --------------------------------------------------------------
  - path: /opt/concerto/mcp_server.py
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env python3
      """Concerto MCP server - runs on the customer's VPS.

      FastMCP server (streamable HTTP transport, mcp>=1.2) with Bearer auth.
      Listens on http://127.0.0.1:9876 (behind nginx + cloudflared tunnel).

      Auth: Bearer token read from /etc/concerto/token (generated at provision time).
      Session state is in-process memory; sessions are lost on restart.
      """
      from __future__ import annotations

      import asyncio
      import os
      import time
      import uuid
      from pathlib import Path
      from typing import Any

      import anyio
      from mcp.server.fastmcp import FastMCP

      TOKEN_PATH = Path(os.environ.get("CONCERTO_TOKEN_PATH", "/etc/concerto/token"))
      SESSION_DIR = Path("/var/lib/concerto/sessions")

      _sessions: dict[str, dict[str, Any]] = {}


      def _read_token() -> str:
          return TOKEN_PATH.read_text().strip()


      mcp = FastMCP("concerto", stateless_http=True)


      @mcp.tool()
      async def start_claude_session(
          prompt: str,
          model: str = "claude-sonnet-4-5",
      ) -> dict[str, Any]:
          """Launch a `claude -p` session in the background.

          Returns {session_id, status} immediately. Poll get_claude_session() for output.
          stream-json output is captured and stored per-session (last 500 lines).
          """
          session_id = uuid.uuid4().hex[:10]
          SESSION_DIR.mkdir(parents=True, exist_ok=True)

          _sessions[session_id] = {
              "id": session_id,
              "status": "running",
              "started_at": time.time(),
              "prompt": prompt[:300],
              "model": model,
              "output_lines": [],
              "exit_code": None,
              "error": None,
          }

          task = asyncio.get_event_loop().create_task(
              _run_claude(session_id, prompt, model),
              name=f"claude-{session_id}",
          )
          _sessions[session_id]["_task"] = task
          return {"session_id": session_id, "status": "running"}


      @mcp.tool()
      async def list_claude_sessions() -> list[dict[str, Any]]:
          """Return all known sessions with id, status, model, and prompt preview."""
          return [
              {
                  "id": s["id"],
                  "status": s["status"],
                  "started_at": s["started_at"],
                  "model": s["model"],
                  "prompt_preview": s["prompt"][:80],
              }
              for s in _sessions.values()
          ]


      @mcp.tool()
      async def get_claude_session(session_id: str) -> dict[str, Any]:
          """Return full output and status of a session by session_id."""
          s = _sessions.get(session_id)
          if s is None:
              return {"error": f"session {session_id!r} not found"}
          return {
              "id": s["id"],
              "status": s["status"],
              "started_at": s["started_at"],
              "model": s["model"],
              "exit_code": s.get("exit_code"),
              "error": s.get("error"),
              "output_lines": s.get("output_lines", []),
          }


      @mcp.tool()
      async def kill_claude_session(session_id: str) -> dict[str, Any]:
          """Cancel a running claude session (sends SIGTERM via anyio task cancellation)."""
          s = _sessions.get(session_id)
          if s is None:
              return {"error": f"session {session_id!r} not found"}
          if s["status"] != "running":
              return {"session_id": session_id, "status": s["status"], "message": "already finished"}

          task: asyncio.Task | None = s.pop("_task", None)
          if task and not task.done():
              task.cancel()
              try:
                  await task
              except (asyncio.CancelledError, Exception):
                  pass

          s["status"] = "killed"
          return {"session_id": session_id, "status": "killed"}


      async def _run_claude(session_id: str, prompt: str, model: str) -> None:
          s = _sessions[session_id]
          cmd = [
              "claude", "-p", prompt,
              "--output-format", "stream-json",
              "--model", model,
              "--no-update-check",
          ]
          try:
              result = await anyio.run_process(cmd, check=False)
              raw = result.stdout.decode("utf-8", errors="replace")
              s["output_lines"] = raw.splitlines()[-500:]
              s["exit_code"] = result.returncode
              s["status"] = "done"
          except asyncio.CancelledError:
              s["status"] = "killed"
              raise
          except Exception as exc:
              s["status"] = "failed"
              s["error"] = str(exc)
          finally:
              s.pop("_task", None)


      def main() -> None:
          import uvicorn
          from starlette.middleware.base import BaseHTTPMiddleware
          from starlette.requests import Request as _Request
          from starlette.responses import JSONResponse

          class BearerAuth(BaseHTTPMiddleware):
              async def dispatch(self, request: _Request, call_next):
                  if request.url.path == "/healthz":
                      return await call_next(request)
                  try:
                      expected = _read_token()
                  except OSError:
                      return JSONResponse({"error": "token file not readable"}, status_code=503)
                  auth = request.headers.get("Authorization", "")
                  if not auth.lower().startswith("bearer "):
                      return JSONResponse({"error": "missing bearer token"}, status_code=401)
                  if auth.split(" ", 1)[1].strip() != expected:
                      return JSONResponse({"error": "invalid bearer token"}, status_code=401)
                  return await call_next(request)

          app = mcp.streamable_http_app()
          app.add_middleware(BearerAuth)
          uvicorn.run(app, host="127.0.0.1", port=9876, log_level="info")


      if __name__ == "__main__":
          main()

  # -- nginx reverse proxy -----------------------------------------------------
  - path: /etc/nginx/conf.d/concerto.conf
    owner: root:root
    permissions: '0644'
    content: |
      server {
          listen 8080;
          server_name _;

          # MCP server (all non-terminal traffic)
          location / {
              proxy_pass         http://127.0.0.1:9876;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
              proxy_set_header   X-Forwarded-Proto $scheme;
              proxy_read_timeout 300s;
              proxy_send_timeout 300s;
          }

          # Redirect /terminal to /terminal/ for clean WebSocket URL
          location = /terminal {
              return 301 /terminal/;
          }

          # ttyd web terminal - must proxy WebSocket (Upgrade header) and
          # forward Authorization for ttyd Basic Auth validation (F2).
          location /terminal/ {
              proxy_pass         http://127.0.0.1:7681/;
              proxy_http_version 1.1;
              proxy_set_header   Upgrade           $http_upgrade;
              proxy_set_header   Connection        "upgrade";
              proxy_set_header   Host              $host;
              proxy_set_header   Authorization     $http_authorization;
              proxy_read_timeout 3600s;
              proxy_send_timeout 3600s;
          }
      }

  # -- systemd: MCP server -----------------------------------------------------
  - path: /etc/systemd/system/concerto-mcp.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Concerto MCP Server
      Documentation=https://github.com/ethanadjedj-labs/concerto
      After=network.target

      [Service]
      Type=simple
      ExecStart=/opt/concerto/.venv/bin/python /opt/concerto/mcp_server.py
      Restart=always
      RestartSec=5
      EnvironmentFile=/etc/concerto/env

      [Install]
      WantedBy=multi-user.target

  # -- systemd: cloudflared tunnel ---------------------------------------------
  # Named tunnel (solo/pro): cloudflared authenticates via --token, exposes a
  # stable *.workspaces.concerto.run hostname. Survives reboots.
  # Ephemeral tunnel (trial/byoc): falls back to --url quick tunnel.
  - path: /etc/systemd/system/concerto-tunnel.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Concerto Cloudflared Tunnel
      Documentation=https://github.com/ethanadjedja-labs/concerto
      After=network.target concerto-mcp.service concerto-ttyd.service nginx.service

      [Service]
      Type=simple
      {% if tunnel_token %}ExecStart=/usr/local/bin/cloudflared tunnel run --token {{ tunnel_token }}
      {% else %}ExecStart=/usr/local/bin/cloudflared tunnel --url http://127.0.0.1:8080
      StandardOutput=append:/var/log/cloudflared-quicktunnel.log
      StandardError=append:/var/log/cloudflared-quicktunnel.log
      {% endif %}Restart=always
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

  # -- concerto-login-shell: wrapper spawned by ttyd ----------------------------
  # On connect the user sees `claude login` already running — they just paste
  # the OAuth code. After login exits ttyd shows "connection closed"; the wizard
  # auto-advances via the oauth-status poll. Reconnecting re-runs the wrapper
  # (claude login is idempotent when already authenticated).
  - path: /usr/local/bin/concerto-login-shell
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      clear
      echo "Sign in to Claude — follow the URL below in your browser, then paste the code here."
      echo ""
      exec claude login

  # -- systemd: ttyd web terminal ----------------------------------------------
  # F2: --credential from TTYD_PASSWORD env var (set via EnvironmentFile)
  # F3: --client-option flags for iframe embedding
  # F6: KillMode=control-group kills bash children on stop;
  #     ExecStopPost cleans up any zombie bash processes
  - path: /etc/systemd/system/concerto-ttyd.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Concerto TTYd Web Terminal
      Documentation=https://github.com/ethanadjedja-labs/concerto
      After=network.target

      [Service]
      Type=simple
      EnvironmentFile=/etc/concerto/ttyd.env
      ExecStart=/usr/bin/ttyd -p 7681 -i 127.0.0.1 \
        --credential concerto:${TTYD_PASSWORD} \
        --client-option disableLeaveAlert=true \
        --client-option titleFixed=Concerto \
        /usr/local/bin/concerto-login-shell
      Restart=always
      RestartSec=5
      KillMode=control-group
      ExecStopPost=/bin/bash -c 'pkill -TERM -x concerto-login-shell 2>/dev/null || true'

      [Install]
      WantedBy=multi-user.target

  # -- provision completion script ---------------------------------------------
  # F4: SSH key is already written by cloud-init ssh_authorized_keys section
  #     before runcmd runs - this script verifies then sleeps 5s before POST.
  # F5: Polls /var/log/cloudflared-quicktunnel.log (written by concerto-tunnel
  #     systemd service) with 60s timeout + retry-on-empty.
  - path: /opt/concerto/provision_complete.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      source /etc/concerto/env

      # -- F4: verify SSH authorized_keys is in place before reporting back -----
      echo "[concerto] Verifying SSH authorized_keys..."
      if [ ! -f /root/.ssh/authorized_keys ] || [ ! -s /root/.ssh/authorized_keys ]; then
        echo "[concerto] WARNING: authorized_keys missing or empty - SSH access may be broken" >&2
      else
        echo "[concerto] SSH authorized_keys OK ($(wc -l < /root/.ssh/authorized_keys) key(s))"
      fi

      # -- Resolve tunnel URL ---------------------------------------------------
      # Named tunnel (solo/pro): hostname is stable and already known.
      # Ephemeral tunnel (trial/byoc): poll the log for the trycloudflare URL.
      {% if tunnel_hostname %}TUNNEL_URL="https://{{ tunnel_hostname }}"
      echo "[concerto] Named tunnel URL: ${TUNNEL_URL}"
      {% else %}echo "[concerto] Waiting for ephemeral cloudflare tunnel URL (max 60s)..."
      TUNNEL_URL=""
      for i in $(seq 1 30); do
        if [ -f /var/log/cloudflared-quicktunnel.log ]; then
          TUNNEL_URL=$(
            grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' \
              /var/log/cloudflared-quicktunnel.log 2>/dev/null | head -1 || true
          )
        fi
        [ -n "$TUNNEL_URL" ] && break
        sleep 2
      done

      if [ -z "$TUNNEL_URL" ]; then
        echo "[concerto] ERROR: tunnel URL not found after 60s" >&2
        cat /var/log/cloudflared-quicktunnel.log >&2 || true
        exit 1
      fi

      echo "[concerto] Ephemeral tunnel URL: ${TUNNEL_URL}"
      {% endif %}

      # -- Read the freshly-generated bearer token -------------------------------
      BEARER_TOKEN=$(cat /etc/concerto/token)

      # -- F4: sleep 5s to ensure SSH daemon has fully processed authorized_keys -
      echo "[concerto] Sleeping 5s before reporting back..."
      sleep 5

      # -- POST results back to empire backend -----------------------------------
      curl -fsSL -X POST "${CONCERTO_CALLBACK_URL}" \
        -H "Content-Type: application/json" \
        -H "X-Callback-Secret: ${TTYD_PASSWORD}" \
        -d "{
          \"token\":         \"${CONCERTO_TOKEN}\",
          \"mcp_url\":       \"${TUNNEL_URL}\",
          \"bearer_token\":  \"${BEARER_TOKEN}\",
          \"ttyd_url\":      \"${TUNNEL_URL}/terminal\"
        }"

      echo "[concerto] Provisioning complete."

# --- runcmd (runs on first boot as root, sequentially) -----------------------

runcmd:
  # -- 0. Write SSH key FIRST (belt-and-suspenders; ssh_authorized_keys module already ran)
  # NOTE: passwd -l root is intentionally ABSENT — locking root on Ubuntu 22.04 with
  # UsePAM yes causes PAM to deny even SSH key auth (shadow '!' prefix). DO NOT re-add.
  - ["bash", "-c", "mkdir -p /root/.ssh && chmod 700 /root/.ssh && echo \"{{ ssh_authorized_key }}\" > /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys"]

  # -- 1. System packages (DEBIAN_FRONTEND=noninteractive; release unattended-upgrades lock first)
  - ["bash", "-c", "systemctl stop unattended-upgrades.service apt-daily.service apt-daily-upgrade.service 2>/dev/null; systemctl disable apt-daily.timer apt-daily-upgrade.timer 2>/dev/null; true"]
  - ["bash", "-c", "while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; do echo waiting for apt lock; sleep 3; done; true"]
  - ["bash", "-c", "DEBIAN_FRONTEND=noninteractive apt-get update -qq"]
  - ["bash", "-c", "DEBIAN_FRONTEND=noninteractive apt-get install -y -o DPkg::Lock::Timeout=300 curl python3-venv tmux git ttyd nginx"]

  # -- 2. Node.js 20 via NodeSource ------------------------------------------
  - ["bash", "-c", "curl -fsSL https://deb.nodesource.com/setup_20.x | bash -"]
  - ["apt-get", "install", "-y", "nodejs"]

  # -- 3. Claude Code CLI ----------------------------------------------------
  - ["npm", "install", "-g", "@anthropic-ai/claude-code"]

  # -- 4. cloudflared (latest .deb release from GitHub) ---------------------
  - ["bash", "-c",
     "curl -fsSL https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb -o /tmp/cloudflared.deb && dpkg -i /tmp/cloudflared.deb"]

  # -- 5. Concerto Python venv + MCP deps ------------------------------------
  - ["bash", "-c",
     "python3 -m venv /opt/concerto/.venv && /opt/concerto/.venv/bin/pip install --quiet --upgrade pip && /opt/concerto/.venv/bin/pip install --quiet 'mcp[cli]>=1.2' anyio fastapi 'uvicorn[standard]'"]

  # -- 6. Generate MCP bearer token -----------------------------------------
  - ["bash", "-c", "openssl rand -hex 32 > /etc/concerto/token && chmod 600 /etc/concerto/token"]

  # -- 7. Session storage directory ------------------------------------------
  - ["mkdir", "-p", "/var/lib/concerto/sessions"]

  # -- 8. F4: verify SSH authorized_keys before starting services ------------
  # cloud-init ssh_authorized_keys runs before runcmd, so key is already present.
  - ["bash", "-c", "mkdir -p /root/.ssh && chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys 2>/dev/null || true"]


  # -- 9. nginx: disable default site, test config ---------------------------
  - ["bash", "-c", "rm -f /etc/nginx/sites-enabled/default && nginx -t"]

  # -- 10. Prepare cloudflared log file -------------------------------------
  # F5: concerto-tunnel.service appends to this file; pre-create it so
  # provision_complete.sh poll doesn't fail on first iteration.
  - ["bash", "-c", "touch /var/log/cloudflared-quicktunnel.log && chmod 644 /var/log/cloudflared-quicktunnel.log"]

  # -- 11. systemd: reload, enable, start all units --------------------------
  # Start nginx + MCP + ttyd first, then tunnel (which depends on them).
  # F4: SSH is ready (ssh_authorized_keys processed) before we reach here.
  - ["systemctl", "daemon-reload"]
  # Disable Ubuntu apt's default ttyd service (port 7681 conflict with concerto-ttyd)
  - ["bash", "-c", "systemctl stop ttyd.service 2>/dev/null; systemctl disable ttyd.service 2>/dev/null; true"]
  - ["bash", "-c",
     "systemctl enable concerto-mcp concerto-ttyd concerto-tunnel nginx && systemctl start nginx concerto-mcp concerto-ttyd"]
  # F5: brief pause to let ttyd fully bind before cloudflared starts
  - ["bash", "-c", "sleep 3 && systemctl start concerto-tunnel"]

  # -- 12. Wait for tunnel URL and POST back to empire backend ---------------
  - ["/opt/concerto/provision_complete.sh"]

  # -- 13. Workspace directory permissions ----------------------------------
  - ["bash", "-c",
     "find /opt/concerto-workspace -type d -exec chmod 755 {} + && find /opt/concerto-workspace -type f -exec chmod 644 {} +"]
  - ["bash", "-c", "chown -R root:root /opt/concerto-workspace"]

  # -- 14. Default working directory when SSH'd in ---------------------------
  - ["bash", "-c",
     "echo 'cd /opt/concerto-workspace' >> /root/.bashrc"]

