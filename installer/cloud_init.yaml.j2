#cloud-config
# Concerto installer - Jinja2 template rendered by the empire backend.
#
# Template variables (all required):
#   concerto_token        - per-provisioning callback token (identifies this droplet)
#   concerto_callback_url - backend webhook URL to POST the tunnel/bearer details to
#   ssh_authorized_key   - backend-generated public key for terminal proxy access
#   customer_email       - customer email for audit logs
#   ttyd_password        - random 32-char hex credential for ttyd Basic Auth (F2)
#   concerto_token_prefix - first 8 chars of bearer_token (display only)
#
# Rendered YAML is injected into DigitalOcean Droplet user-data at provision time.
# cloud-init runs runcmd on first boot as root.

# Disable cloud-init's own package_update/upgrade -- we manage apt in runcmd
package_update: false
package_upgrade: false

# bootcmd runs during cloud-init INIT phase (before network/config phases).
# Kill unattended-upgrades EARLY so apt lock is free when cc_packages (config
# phase) and our runcmd (final phase) run -- otherwise both hang indefinitely
# waiting for /var/lib/dpkg/lock-frontend held by DO's unattended-upgrades.
bootcmd:
  - ["systemctl", "stop", "unattended-upgrades.service", "apt-daily.service", "apt-daily-upgrade.service"]
  - ["systemctl", "disable", "apt-daily.timer", "apt-daily-upgrade.timer"]
  - ["bash", "-c", "while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; do sleep 1; done; true"]

# --- SSH ---------------------------------------------------------------------
# F4: ssh_authorized_keys is processed by cloud-init BEFORE runcmd executes,
# guaranteeing the key is in place before any service starts.

ssh_authorized_keys:
  - "{{ ssh_authorized_key }}"

# --- Write files (before runcmd) ---------------------------------------------

write_files:

  # Concerto environment - callback URL and provisioning identity
  - path: /etc/concerto/env
    owner: root:root
    permissions: '0600'
    content: |
      CONCERTO_CALLBACK_URL={{ concerto_callback_url }}
      CONCERTO_TOKEN={{ concerto_token }}
      CUSTOMER_EMAIL={{ customer_email }}
      TUNNEL_HOSTNAME={{ tunnel_hostname }}

  # Version stamp
  - path: /etc/concerto/version
    owner: root:root
    permissions: '0644'
    content: "1.0.0\n"

  # F2: ttyd credential file - password is rendered at provision time
  - path: /etc/concerto/ttyd.env
    owner: root:root
    permissions: '0600'
    content: |
      TTYD_PASSWORD={{ ttyd_password }}


  # -- concerto-workspace base files --------------------------------------------
  # These are seeded onto the customer VPS at /opt/concerto-workspace/.
  # {{ customer_email }} and {{ concerto_token_prefix }} are Jinja2-rendered at provision time.

  - path: /opt/concerto-workspace/OPS/MANAGER_STATE.md
    owner: root:root
    permissions: '0644'
    content: |
      # Manager State - {{ customer_email }}'s Concerto

      Last updated: <fill on first edit>

      ## Active strategic decisions

      (Write your standing decisions here - what you're building, your business thesis, what you've chosen to ignore.)

      ## Active projects

      (List each active project as a section. When state changes, edit here.)

      ## Pending operator decisions

      (Open questions that block your sessions. Sessions should write here when they can't proceed alone.)

      ## Conventions

      - Sessions read this file before substantive work.
      - Sessions write back here when state changes.
      - This file is your future-self handoff.

  - path: /opt/concerto-workspace/OPS/SESSION_RULES.md
    owner: root:root
    permissions: '0644'
    content: |
      # Session Rules - read at the start of every spawned session

      This file defines binding conventions for Claude Code sessions on your Concerto VPS.

      ## Read first in every session

      1. /opt/concerto-workspace/OPS/MANAGER_STATE.md - strategic state, decisions, follow-ups
      2. /opt/concerto-workspace/OPS/SESSION_RULES.md - this file
      3. /opt/concerto-workspace/OPS/ENVELOPE_SCHEMA.md - return format

      ## Language and communication

      - Write session prompts in English.
      - Include in prompts: goal, deliverables, acceptance criteria, abort conditions.
      - Return envelopes per ENVELOPE_SCHEMA.md as the final stdout output of every session.

      ## Working directory

      - Default working directory: /opt/concerto-workspace/ or a subdirectory.
      - Prefer idempotent operations. Check before writing.

      ## State hygiene

      - When a session changes consequential state, update MANAGER_STATE.md before closing.
      - Keep session scope focused. Flag scope creep and open a separate session.

      ## Resource caveats

      - Concerto VPS: 2 GiB RAM. Max 2 parallel Claude sessions.
      - Abort and report if RAM drops below 200 MiB.

      ## Universal abort triggers

      - VPS RAM below 200 MiB -> stop and report.
      - Auth issues not resolved -> stop and report.
      - Destructive operation not in task spec -> stop and ask.

      ## Output discipline

      - Every session ends by printing its envelope (JSON) to stdout per ENVELOPE_SCHEMA.md.

  - path: /opt/concerto-workspace/OPS/ENVELOPE_SCHEMA.md
    owner: root:root
    permissions: '0644'
    content: |
      # Envelope Schema - final JSON output of every spawned session

      Print this as the FINAL stdout line of every session (single line, no markdown fences):

      {"status":"ok|partial|aborted|failed","summary":"<1-3 sentences>","artifacts":{"files_created":[],"files_modified":[],"pr_url":"","commits":[]},"next_recommended":"<free text>","decisions_for_operator":[],"errors":[]}

      ## Status values

      - ok: all criteria met
      - partial: some criteria met
      - aborted: hit abort trigger
      - failed: unexpected error

  - path: /opt/concerto-workspace/OPS/queue/pending/.gitkeep
    owner: root:root
    permissions: '0644'
    content: ''

  - path: /opt/concerto-workspace/OPS/queue/done/.gitkeep
    owner: root:root
    permissions: '0644'
    content: ''

  - path: /opt/concerto-workspace/OPS/queue/failed/.gitkeep
    owner: root:root
    permissions: '0644'
    content: ''

  - path: /opt/concerto-workspace/README.md
    owner: root:root
    permissions: '0644'
    content: |
      # Your first 5 minutes with Concerto

      Your Concerto VPS is running Claude Code connected to your claude.ai account.

      ## Step 1 - Send your first session

      In any claude.ai conversation with the Concerto connector active:

        Spawn a Concerto session to write a hello world Python script.

      ## Step 2 - Check the session

        List my Concerto sessions.

      ## Step 3 - Pull the output

        What did the hello world session return?

      ## Step 4 - Do real work

      Replace the hello world prompt with something useful. Examples:
      - Spawn a Concerto session to clone my GitHub repo and run the tests.
      - Spawn a Concerto session to set up a Flask app in /opt/concerto-workspace/myapp/.
      - Spawn 3 parallel sessions: audit backend, lint frontend, check deps.

      See examples/parallel_workflow.md for the parallel pattern.

      ## Step 5 - Edit MANAGER_STATE.md

      Write what you're building in OPS/MANAGER_STATE.md.
      Every future session reads this file first.

  - path: /opt/concerto-workspace/examples/sample_prompt.md
    owner: root:root
    permissions: '0644'
    content: |
      # Sample Session Prompt

      Read /opt/concerto-workspace/OPS/MANAGER_STATE.md and /opt/concerto-workspace/OPS/SESSION_RULES.md before starting.

      ## Goal

      <One sentence: what outcome this session should produce.>

      ## Deliverables

      - <Specific file, endpoint, or state change that must exist when done.>

      ## Acceptance criteria

      - <How to verify the work is correct.>

      ## Working directory

      /opt/concerto-workspace/<subdirectory>

      ## Abort conditions

      - If RAM available drops below 200 MiB.
      - If a required credential is missing.
      - If a destructive operation not in this spec would be required.

      ## Return format

      Print a JSON envelope as the final stdout line per /opt/concerto-workspace/OPS/ENVELOPE_SCHEMA.md.

  - path: /opt/concerto-workspace/examples/parallel_workflow.md
    owner: root:root
    permissions: '0644'
    content: |
      # Parallel Workflow

      In one claude.ai message, ask Claude to spawn N sessions simultaneously:

        Spawn 3 Concerto sessions in parallel:
        1. Session "audit-backend": list Python files over 300 lines.
        2. Session "check-deps": run pip list --outdated.
        3. Session "test-suite": run pytest and return pass/fail counts.

      Then collect results:

        What did audit-backend, check-deps, and test-suite return?

      Resource limits: max 2-3 heavy sessions in parallel on a 2 GiB VPS.

  - path: /opt/concerto-workspace/.claude/CLAUDE.md
    owner: root:root
    permissions: '0644'
    content: |
      # Concerto Workspace

      ## Read at the start of every session

      1. OPS/MANAGER_STATE.md - what you are building, active projects, open decisions
      2. OPS/SESSION_RULES.md - conventions for this workspace
      3. OPS/ENVELOPE_SCHEMA.md - how to format your final output

      ## After substantive work

      Update OPS/MANAGER_STATE.md with what changed before closing.

      ## Output discipline

      End every session by printing a JSON envelope to stdout per OPS/ENVELOPE_SCHEMA.md.

  # -- MCP server --------------------------------------------------------------
  - path: /opt/concerto/mcp_server.py
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env python3
      """Concerto MCP server -- runs on the customer's VPS.

      FastMCP server (streamable HTTP transport, mcp>=1.2) with OAuth 2.1 + PKCE.
      Listens on http://127.0.0.1:9876 (behind nginx + cloudflared tunnel).

      Auth: OAuth 2.1 Bearer tokens (issued by built-in AS) OR legacy Bearer token
            from /etc/concerto/token for backward compatibility.
      Session state is in-process memory; sessions are lost on restart.
      """
      from __future__ import annotations

      import asyncio
      import base64
      import hashlib
      import json
      import logging
      import os
      import time
      import uuid
      from pathlib import Path
      from typing import Any

      import anyio
      from mcp.server.fastmcp import FastMCP
      from mcp.server.transport_security import TransportSecuritySettings

      logger = logging.getLogger("concerto.mcp")

      # ---------------------------------------------------------------------------
      # Paths
      # ---------------------------------------------------------------------------

      TOKEN_PATH = Path(os.environ.get("CONCERTO_TOKEN_PATH", "/etc/concerto/token"))
      SESSION_DIR = Path("/var/lib/concerto/sessions")
      OAUTH_DIR = Path("/var/lib/concerto")
      CLIENTS_PATH = OAUTH_DIR / "oauth_clients.json"
      TOKENS_PATH = OAUTH_DIR / "oauth_tokens.json"

      # ---------------------------------------------------------------------------
      # In-memory state
      # ---------------------------------------------------------------------------

      _sessions: dict[str, dict[str, Any]] = {}

      # code -> {client_id, code_challenge, redirect_uri, expires_at}
      _auth_codes: dict[str, dict[str, Any]] = {}


      # ---------------------------------------------------------------------------
      # Helpers
      # ---------------------------------------------------------------------------


      def _read_token() -> str:
          return TOKEN_PATH.read_text().strip()


      def _base_url(request: Any) -> str:
          proto = (
              request.headers.get("x-forwarded-proto", "").split(",")[0].strip()
              or "http"
          )
          host = (
              request.headers.get("x-forwarded-host", "").split(",")[0].strip()
              or request.headers.get("host", "localhost")
          )
          return f"{proto}://{host}"


      def _pkce_verify(verifier: str, challenge: str) -> bool:
          digest = hashlib.sha256(verifier.encode()).digest()
          computed = base64.urlsafe_b64encode(digest).rstrip(b"=").decode()
          return computed == challenge


      def _load_json(path: Path) -> dict:
          """Read a JSON store, tolerating a concurrent atomic replace.

          Writes use os.replace (atomic), so a reader either sees the old file or
          the new one - never a partial one. We still retry briefly in case the
          file is momentarily absent during the rename window, and we NEVER
          silently return {} on a parse error of a non-empty file (that used to
          mask token loss as an intermittent 401)."""
          import time as _t
          for attempt in range(5):
              try:
                  if not path.exists():
                      return {}
                  raw = path.read_text()
                  if not raw.strip():
                      return {}
                  return json.loads(raw)
              except FileNotFoundError:
                  return {}
              except json.JSONDecodeError:
                  # Should not happen with atomic writes; brief retry then give up
                  # loudly rather than silently dropping every token.
                  if attempt == 4:
                      logger.error("Corrupt JSON store at %s after retries", path)
                      return {}
                  _t.sleep(0.02)
              except OSError:
                  if attempt == 4:
                      return {}
                  _t.sleep(0.02)
          return {}


      def _save_json(path: Path, data: dict) -> None:
          """Atomically replace the JSON store.

          Write to a temp file in the same directory then os.replace() it: the
          rename is atomic on POSIX, so concurrent readers never observe a
          half-written file. This fixes the intermittent 401: /token wrote
          oauth_tokens.json non-atomically while a parallel /mcp read it mid-write,
          saw invalid JSON, and rejected a perfectly valid token."""
          import os as _os
          import tempfile as _tf
          path.parent.mkdir(parents=True, exist_ok=True)
          fd, tmp = _tf.mkstemp(prefix=path.name + ".", dir=str(path.parent))
          try:
              with _os.fdopen(fd, "w") as fh:
                  fh.write(json.dumps(data, indent=2))
                  fh.flush()
                  _os.fsync(fh.fileno())
              _os.replace(tmp, str(path))
          except Exception:
              try:
                  _os.unlink(tmp)
              except OSError:
                  pass
              raise


      def _purge_expired_codes() -> None:
          now = time.time()
          expired = [k for k, v in _auth_codes.items() if v["expires_at"] < now]
          for k in expired:
              del _auth_codes[k]


      # ---------------------------------------------------------------------------
      # MCP server
      # ---------------------------------------------------------------------------

      mcp = FastMCP(
          "concerto",
          instructions=(
              "Concerto runs real Claude Code sessions on the user's own remote "
              "machine. Prefer these tools over building an inline artifact or "
              "answering from the chat WHENEVER the user wants software actually "
              "built, run, tested, or deployed -- e.g. 'build me a Notion clone', "
              "'spin up a backend', 'run the tests', 'fix this repo'. Each "
              "start_claude_session is a full autonomous Claude Code agent with a "
              "shell and filesystem on the user's machine; you can launch several "
              "in parallel and poll them. When the user says 'use Concerto' (or "
              "has the Concerto style active), always route the work through these "
              "tools rather than producing a local artifact."
          ),
          stateless_http=True,
          # FastMCP auto-enables DNS-rebinding protection when host is 127.0.0.1,
          # which 421-rejects the public tunnel Host (ce<hash>.concerto.run) on the
          # post-OAuth /mcp call -> Claude reports "Authorization failed". The server
          # is already protected by OAuth + nginx + the cloudflared tunnel, so this
          # protection is redundant here and must be disabled explicitly.
          transport_security=TransportSecuritySettings(
              enable_dns_rebinding_protection=False
          ),
      )


      @mcp.tool()
      async def start_claude_session(
          prompt: str,
          model: str = "claude-sonnet-4-5",
      ) -> dict[str, Any]:
          """Build, run, test, or deploy software on the user's own machine.

          USE THIS whenever the user wants real engineering work done -- "build me
          a Notion clone", "create the backend", "run the tests", "fix this repo",
          "deploy it". This launches a full autonomous Claude Code agent (its own
          shell + filesystem) on the user's remote machine and does the actual
          work there, instead of you producing an inline artifact or code snippet.

          You can call this MULTIPLE TIMES to run independent pieces of work in
          parallel (e.g. frontend, backend, tests as three sessions), then poll
          each with get_claude_session(session_id).

          `prompt` is the full task instruction handed to the Claude Code agent;
          be specific and self-contained. Returns {session_id, status} immediately
          -- the work runs in the background; poll get_claude_session() for
          progress and final output.
          """
          session_id = uuid.uuid4().hex[:10]
          SESSION_DIR.mkdir(parents=True, exist_ok=True)

          _sessions[session_id] = {
              "id": session_id,
              "status": "running",
              "started_at": time.time(),
              "prompt": prompt[:300],
              "model": model,
              "output_lines": [],
              "exit_code": None,
              "error": None,
          }

          task = asyncio.get_event_loop().create_task(
              _run_claude(session_id, prompt, model),
              name=f"claude-{session_id}",
          )
          _sessions[session_id]["_task"] = task
          return {"session_id": session_id, "status": "running"}


      @mcp.tool()
      async def list_claude_sessions() -> list[dict[str, Any]]:
          """List the Claude Code sessions running (or finished) on the user's
          machine -- use this to see what work is in flight before starting more
          or to find a session_id."""
          return [
              {
                  "id": s["id"],
                  "status": s["status"],
                  "started_at": s["started_at"],
                  "model": s["model"],
                  "prompt_preview": s["prompt"][:80],
              }
              for s in _sessions.values()
          ]


      @mcp.tool()
      async def get_claude_session(session_id: str) -> dict[str, Any]:
          """Check progress and get the output of a Claude Code session you
          started. Poll this after start_claude_session until status is no longer
          'running', then report the result to the user."""
          s = _sessions.get(session_id)
          if s is None:
              return {"error": f"session {session_id!r} not found"}
          return {
              "id": s["id"],
              "status": s["status"],
              "started_at": s["started_at"],
              "model": s["model"],
              "exit_code": s.get("exit_code"),
              "error": s.get("error"),
              "output_lines": s.get("output_lines", []),
          }


      @mcp.tool()
      async def kill_claude_session(session_id: str) -> dict[str, Any]:
          """Stop a running Claude Code session on the user's machine (e.g. the
          user changed their mind or it is going the wrong way)."""
          s = _sessions.get(session_id)
          if s is None:
              return {"error": f"session {session_id!r} not found"}
          if s["status"] != "running":
              return {"session_id": session_id, "status": s["status"], "message": "already finished"}

          task: asyncio.Task | None = s.pop("_task", None)
          if task and not task.done():
              task.cancel()
              try:
                  await task
              except (asyncio.CancelledError, Exception):
                  pass

          s["status"] = "killed"
          return {"session_id": session_id, "status": "killed"}


      def _claude_env() -> dict:
          """Build the env for the claude CLI subprocess.

          The MCP service may be started before the user completes Claude sign-in,
          so relying on systemd EnvironmentFile inheritance is fragile (the token
          file is written later, the service is not always restarted in time, and
          stream-json + a missing token fails as a silent "Not logged in").
          Instead we read /etc/concerto/claude.env at call time and inject
          CLAUDE_CODE_OAUTH_TOKEN explicitly into the child env. This makes
          `claude -p` use the customer's Max token deterministically.
          """
          env = dict(os.environ)
          try:
              for line in Path("/etc/concerto/claude.env").read_text().splitlines():
                  line = line.strip()
                  if not line or line.startswith("#") or "=" not in line:
                      continue
                  k, v = line.split("=", 1)
                  env[k.strip()] = v.strip()
          except OSError:
              pass
          return env


      def _claude_authed() -> bool:
          """True if a usable Max token is present (env file or ~/.claude creds)."""
          env = _claude_env()
          if env.get("CLAUDE_CODE_OAUTH_TOKEN", "").startswith("sk-ant-oat01-"):
              return True
          try:
              return Path("~/.claude/.credentials.json").expanduser().stat().st_size > 2
          except OSError:
              return False


      async def _run_claude(session_id: str, prompt: str, model: str) -> None:
          s = _sessions[session_id]
          if not _claude_authed():
              # Fail loudly and usefully instead of producing an opaque
              # "Not logged in" deep in stream-json output.
              s["status"] = "failed"
              s["error"] = (
                  "Claude is not signed in on this environment yet. Complete the "
                  "'Sign in to Claude' step in the Concerto dashboard, then retry."
              )
              s.pop("_task", None)
              return
          claude_cmd = [
              "claude", "-p", prompt,
              "--output-format", "stream-json", "--verbose",
              "--model", model,
              # Single-tenant sandbox: the background agent must run tools
              # (Bash/Edit/Write) without interactive prompts. claude refuses to
              # bypass permissions while running as root, so we always execute it
              # as the unprivileged `concerto` user (created at provisioning).
              "--permission-mode", "bypassPermissions",
          ]
          cenv = _claude_env()
          run_user = "concerto"
          work_home = f"/home/{run_user}"
          cenv["HOME"] = work_home
          # runuser -u <user> -- preserves our --env via the inherited environment
          # block we pass to anyio; -P keeps the env. Fall back to direct exec if
          # the user somehow does not exist (older droplets) -- then claude is root
          # and will error clearly, which _claude surfaces.
          import shutil as _sh
          if _sh.which("runuser"):
              cmd = [
                  "runuser", "-u", run_user, "--",
                  *claude_cmd,
              ]
          else:
              cmd = claude_cmd
          try:
              result = await anyio.run_process(
                  cmd, check=False, env=cenv, cwd=work_home
              )
              raw = result.stdout.decode("utf-8", errors="replace")
              err = result.stderr.decode("utf-8", errors="replace")
              s["output_lines"] = raw.splitlines()[-500:]
              s["exit_code"] = result.returncode
              if result.returncode != 0:
                  s["status"] = "failed"
                  s["error"] = (err or raw or "claude exited non-zero").strip()[:500]
              else:
                  s["status"] = "done"
          except asyncio.CancelledError:
              s["status"] = "killed"
              raise
          except Exception as exc:
              s["status"] = "failed"
              s["error"] = str(exc)
          finally:
              s.pop("_task", None)


      # ---------------------------------------------------------------------------
      # OAuth 2.1 endpoint handlers
      # ---------------------------------------------------------------------------


      async def as_metadata(request: Any) -> Any:
          """GET /.well-known/oauth-authorization-server -- RFC 8414 AS metadata."""
          from starlette.responses import JSONResponse
          base = _base_url(request)
          return JSONResponse({
              "issuer": base,
              "authorization_endpoint": f"{base}/authorize",
              "token_endpoint": f"{base}/token",
              "registration_endpoint": f"{base}/register",
              "response_types_supported": ["code"],
              "grant_types_supported": ["authorization_code", "refresh_token"],
              "code_challenge_methods_supported": ["S256"],
              "token_endpoint_auth_methods_supported": ["none"],
          })


      async def pr_metadata(request: Any) -> Any:
          """GET /.well-known/oauth-protected-resource[/mcp] -- RFC 9728 resource metadata."""
          from starlette.responses import JSONResponse
          base = _base_url(request)
          return JSONResponse({
              "resource": base,
              "authorization_servers": [base],
          })


      async def register(request: Any) -> Any:
          """POST /register -- RFC 7591 Dynamic Client Registration."""
          from starlette.responses import JSONResponse
          try:
              body = await request.json()
          except Exception:
              body = {}

          client_id = uuid.uuid4().hex
          now = int(time.time())
          record = dict(body)
          record["client_id"] = client_id
          record["client_id_issued_at"] = now
          record["token_endpoint_auth_method"] = "none"

          clients = _load_json(CLIENTS_PATH)
          clients[client_id] = record
          _save_json(CLIENTS_PATH, clients)

          return JSONResponse(record, status_code=201)


      async def authorize(request: Any) -> Any:
          """GET /authorize -- OAuth 2.1 authorization code + PKCE (auto-approve)."""
          from starlette.responses import JSONResponse, RedirectResponse
          params = dict(request.query_params)

          client_id = params.get("client_id", "")
          redirect_uri = params.get("redirect_uri", "")
          code_challenge = params.get("code_challenge", "")
          code_challenge_method = params.get("code_challenge_method", "S256")
          response_type = params.get("response_type", "")
          state = params.get("state", "")

          # Validate required parameters
          missing = []
          if not client_id:
              missing.append("client_id")
          if not redirect_uri:
              missing.append("redirect_uri")
          if not code_challenge:
              missing.append("code_challenge")
          if response_type != "code":
              missing.append("response_type (must be 'code')")

          if missing:
              return JSONResponse(
                  {"error": "invalid_request", "error_description": f"Missing or invalid: {', '.join(missing)}"},
                  status_code=400,
              )

          if code_challenge_method != "S256":
              return JSONResponse(
                  {"error": "invalid_request", "error_description": "Only S256 code_challenge_method is supported"},
                  status_code=400,
              )

          # Validate client_id exists (allow any if registry is empty for bootstrapping)
          clients = _load_json(CLIENTS_PATH)
          if clients and client_id not in clients:
              return JSONResponse(
                  {"error": "invalid_client", "error_description": f"Unknown client_id: {client_id}"},
                  status_code=400,
              )

          # Auto-approve: generate code
          _purge_expired_codes()
          code = uuid.uuid4().hex + uuid.uuid4().hex
          _auth_codes[code] = {
              "client_id": client_id,
              "code_challenge": code_challenge,
              "redirect_uri": redirect_uri,
              "expires_at": time.time() + 600,
          }

          # Build redirect
          separator = "&" if "?" in redirect_uri else "?"
          location = f"{redirect_uri}{separator}code={code}"
          if state:
              location = f"{location}&state={state}"

          return RedirectResponse(url=location, status_code=302)


      async def token_endpoint(request: Any) -> Any:
          """POST /token -- OAuth 2.1 token endpoint."""
          from starlette.responses import JSONResponse

          content_type = request.headers.get("content-type", "")
          if "application/json" in content_type:
              try:
                  body = await request.json()
              except Exception:
                  body = {}
          else:
              # form-encoded
              try:
                  form = await request.form()
                  body = dict(form)
              except Exception:
                  body = {}

          grant_type = body.get("grant_type", "")

          if grant_type == "authorization_code":
              code = body.get("code", "")
              code_verifier = body.get("code_verifier", "")
              redirect_uri = body.get("redirect_uri", "")
              client_id = body.get("client_id", "")

              if not code or not code_verifier:
                  return JSONResponse(
                      {"error": "invalid_request", "error_description": "Missing code or code_verifier"},
                      status_code=400,
                  )

              _purge_expired_codes()
              stored = _auth_codes.get(code)
              if stored is None:
                  return JSONResponse(
                      {"error": "invalid_grant", "error_description": "Authorization code not found or expired"},
                      status_code=400,
                  )

              if stored["expires_at"] < time.time():
                  del _auth_codes[code]
                  return JSONResponse(
                      {"error": "invalid_grant", "error_description": "Authorization code expired"},
                      status_code=400,
                  )

              if client_id and stored["client_id"] != client_id:
                  return JSONResponse(
                      {"error": "invalid_grant", "error_description": "client_id mismatch"},
                      status_code=400,
                  )

              if redirect_uri and stored["redirect_uri"] != redirect_uri:
                  return JSONResponse(
                      {"error": "invalid_grant", "error_description": "redirect_uri mismatch"},
                      status_code=400,
                  )

              if not _pkce_verify(code_verifier, stored["code_challenge"]):
                  return JSONResponse(
                      {"error": "invalid_grant", "error_description": "PKCE verification failed"},
                      status_code=400,
                  )

              # Consume the code
              del _auth_codes[code]

              # Issue tokens
              access_token = uuid.uuid4().hex + uuid.uuid4().hex
              refresh_token = uuid.uuid4().hex + uuid.uuid4().hex
              expires_in = 3600
              now = time.time()

              tokens = _load_json(TOKENS_PATH)
              tokens[access_token] = {
                  "client_id": stored["client_id"],
                  "refresh_token": refresh_token,
                  "expires_at": now + expires_in,
                  "scope": body.get("scope", ""),
              }
              # Also index by refresh_token for grant_type=refresh_token
              tokens[f"rt:{refresh_token}"] = {
                  "client_id": stored["client_id"],
                  "access_token": access_token,
                  "expires_at": now + 86400 * 30,
              }
              _save_json(TOKENS_PATH, tokens)

              return JSONResponse({
                  "access_token": access_token,
                  "token_type": "Bearer",
                  "expires_in": expires_in,
                  "refresh_token": refresh_token,
              })

          elif grant_type == "refresh_token":
              refresh_token = body.get("refresh_token", "")
              if not refresh_token:
                  return JSONResponse(
                      {"error": "invalid_request", "error_description": "Missing refresh_token"},
                      status_code=400,
                  )

              tokens = _load_json(TOKENS_PATH)
              rt_key = f"rt:{refresh_token}"
              rt_record = tokens.get(rt_key)

              if rt_record is None:
                  return JSONResponse(
                      {"error": "invalid_grant", "error_description": "refresh_token not found"},
                      status_code=400,
                  )

              if rt_record["expires_at"] < time.time():
                  return JSONResponse(
                      {"error": "invalid_grant", "error_description": "refresh_token expired"},
                      status_code=400,
                  )

              # Revoke old access token if present
              old_at = rt_record.get("access_token")
              if old_at and old_at in tokens:
                  del tokens[old_at]

              # Issue new access token
              new_access_token = uuid.uuid4().hex + uuid.uuid4().hex
              expires_in = 3600
              now = time.time()
              client_id = rt_record["client_id"]

              tokens[new_access_token] = {
                  "client_id": client_id,
                  "refresh_token": refresh_token,
                  "expires_at": now + expires_in,
                  "scope": "",
              }
              tokens[rt_key]["access_token"] = new_access_token

              _save_json(TOKENS_PATH, tokens)

              return JSONResponse({
                  "access_token": new_access_token,
                  "token_type": "Bearer",
                  "expires_in": expires_in,
                  "refresh_token": refresh_token,
              })

          else:
              return JSONResponse(
                  {"error": "unsupported_grant_type", "error_description": f"grant_type {grant_type!r} not supported"},
                  status_code=400,
              )


      # ---------------------------------------------------------------------------
      # App assembly
      # ---------------------------------------------------------------------------

      # Paths that bypass authentication entirely
      _UNAUTH_EXACT = {"/healthz", "/authorize", "/register", "/token"}
      _UNAUTH_PREFIXES = ("/.well-known/",)

      # OAuth endpoint dispatch table: path -> (method, handler)
      _OAUTH_ROUTES: dict[str, tuple[str, Any]] = {
          "/.well-known/oauth-authorization-server": ("GET", as_metadata),
          "/.well-known/oauth-protected-resource": ("GET", pr_metadata),
          "/.well-known/oauth-protected-resource/mcp": ("GET", pr_metadata),
          "/register": ("POST", register),
          "/authorize": ("GET", authorize),
          "/token": ("POST", token_endpoint),
      }


      def _is_unauthenticated_path(path: str) -> bool:
          if path in _UNAUTH_EXACT:
              return True
          for prefix in _UNAUTH_PREFIXES:
              if path.startswith(prefix):
                  return True
          return False


      def _check_bearer(request: Any) -> bool:
          """Return True if the request carries a valid OAuth or legacy bearer token."""
          auth = request.headers.get("Authorization", "")
          if not auth.lower().startswith("bearer "):
              return False
          token = auth.split(" ", 1)[1].strip()

          # Check OAuth tokens store
          tokens = _load_json(TOKENS_PATH)
          record = tokens.get(token)
          if record is not None:
              if record.get("expires_at", 0) >= time.time():
                  return True

          # Fall back to legacy static token
          try:
              expected = _read_token()
              if token == expected:
                  return True
          except OSError:
              pass

          return False


      class CombinedApp:
          """ASGI application that handles OAuth endpoints directly and proxies the rest to mcp_app."""

          def __init__(self, mcp_app: Any) -> None:
              self.mcp_app = mcp_app

          async def __call__(self, scope: Any, receive: Any, send: Any) -> None:
              from starlette.requests import Request
              from starlette.responses import JSONResponse, Response

              if scope["type"] == "lifespan":
                  await self.mcp_app(scope, receive, send)
                  return

              if scope["type"] != "http":
                  await self.mcp_app(scope, receive, send)
                  return

              path = scope.get("path", "/")
              method = scope.get("method", "GET")

              # --- OAuth / public endpoints ---
              if path in _OAUTH_ROUTES:
                  expected_method, handler = _OAUTH_ROUTES[path]
                  if method == expected_method:
                      request = Request(scope, receive)
                      response = await handler(request)
                      await response(scope, receive, send)
                      return
                  # Method not allowed
                  response = Response(status_code=405)
                  await response(scope, receive, send)
                  return

              # --- Health check ---
              if path == "/healthz":
                  response = JSONResponse({"status": "ok"})
                  await response(scope, receive, send)
                  return

              # --- Auth check for all other paths ---
              request = Request(scope, receive)
              if not _check_bearer(request):
                  base = _base_url(request)
                  resource_meta = f"{base}/.well-known/oauth-protected-resource"
                  www_auth = f'Bearer resource_metadata="{resource_meta}"'
                  response = JSONResponse(
                      {"error": "unauthorized", "error_description": "Valid Bearer token required"},
                      status_code=401,
                      headers={"WWW-Authenticate": www_auth},
                  )
                  await response(scope, receive, send)
                  return

              # Authenticated -- forward to the MCP app.
              # FastMCP's streamable transport only serves the protocol at /mcp.
              # Claude, given the bare connector URL (no /mcp suffix), performs
              # OAuth fine but then POSTs its JSON-RPC to "/" -> FastMCP 404 ->
              # Claude reports "Authorization with the MCP server failed". Normalise
              # the path so the MCP protocol is reachable at BOTH "/" and "/mcp"
              # (and "/mcp/..."), regardless of what the user pasted.
              mcp_path = "/mcp"
              if path != mcp_path and not path.startswith(mcp_path + "/"):
                  scope = dict(scope)
                  scope["path"] = mcp_path
                  raw = scope.get("raw_path")
                  if raw is not None:
                      try:
                          query = scope.get("query_string", b"")
                          scope["raw_path"] = mcp_path.encode() + (
                              b"?" + query if query else b""
                          )
                      except Exception:
                          scope["raw_path"] = mcp_path.encode()
              await self.mcp_app(scope, receive, send)


      def main() -> None:
          import uvicorn

          mcp_app = mcp.streamable_http_app()
          app = CombinedApp(mcp_app)
          uvicorn.run(app, host="127.0.0.1", port=9876, log_level="info")


      if __name__ == "__main__":
          main()

  # -- nginx reverse proxy -----------------------------------------------------
  - path: /etc/nginx/conf.d/concerto.conf
    owner: root:root
    permissions: '0644'
    content: |
      # cloudflared terminates TLS at the edge and connects to nginx over
      # plain http on 127.0.0.1:8080, so $scheme is always "http" here.
      # The real client scheme is in the X-Forwarded-Proto header cloudflared
      # sends. Trust it; default to https because the public cloudflared
      # tunnel is always https. Using $scheme made the MCP server advertise
      # http:// OAuth endpoints -> Claude "Authorization with the MCP server failed".
      map $http_x_forwarded_proto $concerto_fwd_proto {
          default   $http_x_forwarded_proto;
          ""        https;
      }

      server {
          listen 8080;
          server_name _;

          # MCP server (all non-terminal traffic)
          location / {
              proxy_pass         http://127.0.0.1:9876;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
              proxy_set_header   X-Forwarded-Proto $concerto_fwd_proto;
              proxy_read_timeout 300s;
              proxy_send_timeout 300s;
          }

          # Redirect /terminal to /terminal/ for clean WebSocket URL
          location = /terminal {
              return 301 /terminal/;
          }

          # ttyd web terminal - must proxy WebSocket (Upgrade header) and
          # forward Authorization for ttyd Basic Auth validation (F2).
          location /terminal/ {
              proxy_pass         http://127.0.0.1:7681/;
              proxy_http_version 1.1;
              proxy_set_header   Upgrade           $http_upgrade;
              proxy_set_header   Connection        "upgrade";
              proxy_set_header   Host              $host;
              proxy_set_header   Authorization     $http_authorization;
              proxy_read_timeout 3600s;
              proxy_send_timeout 3600s;
          }
      }

  # -- systemd: MCP server -----------------------------------------------------
  - path: /etc/systemd/system/concerto-mcp.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Concerto MCP Server
      Documentation=https://github.com/ethanadjedj-labs/concerto
      After=network.target

      [Service]
      Type=simple
      ExecStart=/opt/concerto/.venv/bin/python /opt/concerto/mcp_server.py
      Restart=always
      RestartSec=5
      EnvironmentFile=/etc/concerto/env

      [Install]
      WantedBy=multi-user.target

  # -- systemd: cloudflared tunnel ---------------------------------------------
  # Named tunnel (solo/pro): cloudflared authenticates via --token, exposes a
  # stable *.workspaces.concerto.run hostname. Survives reboots.
  # Ephemeral tunnel (trial/byoc): falls back to --url quick tunnel.
  - path: /etc/systemd/system/concerto-tunnel.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Concerto Cloudflared Tunnel
      Documentation=https://github.com/ethanadjedja-labs/concerto
      After=network.target concerto-mcp.service concerto-ttyd.service nginx.service

      [Service]
      Type=simple
      {% if tunnel_hostname %}ExecStart=/usr/local/bin/cloudflared tunnel run --token {{ tunnel_token }}
      {% else %}ExecStart=/usr/local/bin/cloudflared tunnel --url http://127.0.0.1:8080
      StandardOutput=append:/var/log/cloudflared-quicktunnel.log
      StandardError=append:/var/log/cloudflared-quicktunnel.log
      {% endif %}Restart=always
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

  # -- concerto-login-shell: wrapper spawned by ttyd ----------------------------
  # On connect the user sees `claude login` already running -- they just paste
  # the OAuth code. After login exits ttyd shows "connection closed"; the wizard
  # auto-advances via the oauth-status poll. Reconnecting re-runs the wrapper
  # (claude login is idempotent when already authenticated).
  - path: /usr/local/bin/concerto-login-shell
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      clear
      echo "Sign in to Claude -- follow the URL below in your browser, then paste the code here."
      echo ""
      exec claude login

  # -- systemd: ttyd web terminal ----------------------------------------------
  # F2: --credential from TTYD_PASSWORD env var (set via EnvironmentFile)
  # F3: --client-option flags for iframe embedding
  # F6: KillMode=control-group kills bash children on stop;
  #     ExecStopPost cleans up any zombie bash processes
  - path: /etc/systemd/system/concerto-ttyd.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Concerto TTYd Web Terminal
      Documentation=https://github.com/ethanadjedja-labs/concerto
      After=network.target

      [Service]
      Type=simple
      EnvironmentFile=/etc/concerto/ttyd.env
      ExecStart=/usr/bin/ttyd -p 7681 -i 127.0.0.1 \
        --credential concerto:${TTYD_PASSWORD} \
        --client-option disableLeaveAlert=true \
        --client-option titleFixed=Concerto \
        /usr/local/bin/concerto-login-shell
      Restart=always
      RestartSec=5
      KillMode=control-group
      ExecStopPost=/bin/bash -c 'pkill -TERM -x concerto-login-shell 2>/dev/null || true'

      [Install]
      WantedBy=multi-user.target

  # -- provision completion script ---------------------------------------------
  # F4: SSH key is already written by cloud-init ssh_authorized_keys section
  #     before runcmd runs - this script verifies then sleeps 5s before POST.
  # F5: Polls /var/log/cloudflared-quicktunnel.log (written by concerto-tunnel
  #     systemd service) with 60s timeout + retry-on-empty.
  - path: /opt/concerto/provision_complete.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      source /etc/concerto/env
      source /etc/concerto/ttyd.env

      # -- F4: verify SSH authorized_keys is in place before reporting back -----
      echo "[concerto] Verifying SSH authorized_keys..."
      if [ ! -f /root/.ssh/authorized_keys ] || [ ! -s /root/.ssh/authorized_keys ]; then
        echo "[concerto] WARNING: authorized_keys missing or empty - SSH access may be broken" >&2
      else
        echo "[concerto] SSH authorized_keys OK ($(wc -l < /root/.ssh/authorized_keys) key(s))"
      fi

      # -- Resolve tunnel URL ---------------------------------------------------
      # Named tunnel (solo/pro): hostname is stable and already known.
      # Ephemeral tunnel (trial/byoc): poll the log for the trycloudflare URL.
      {% if tunnel_hostname %}TUNNEL_URL="https://{{ tunnel_hostname }}"
      echo "[concerto] Named tunnel URL: ${TUNNEL_URL}"
      {% else %}echo "[concerto] Waiting for ephemeral cloudflare tunnel URL (max 60s)..."
      TUNNEL_URL=""
      for i in $(seq 1 30); do
        if [ -f /var/log/cloudflared-quicktunnel.log ]; then
          TUNNEL_URL=$(
            grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' \
              /var/log/cloudflared-quicktunnel.log 2>/dev/null | head -1 || true
          )
        fi
        [ -n "$TUNNEL_URL" ] && break
        sleep 2
      done

      if [ -z "$TUNNEL_URL" ]; then
        echo "[concerto] ERROR: tunnel URL not found after 60s" >&2
        cat /var/log/cloudflared-quicktunnel.log >&2 || true
        exit 1
      fi

      echo "[concerto] Ephemeral tunnel URL: ${TUNNEL_URL}"
      {% endif %}

      # -- Read the freshly-generated bearer token -------------------------------
      BEARER_TOKEN=$(cat /etc/concerto/token)

      # -- F4: sleep 5s to ensure SSH daemon has fully processed authorized_keys -
      echo "[concerto] Sleeping 5s before reporting back..."
      sleep 5

      # -- POST results back to empire backend -----------------------------------
      curl -fsSL -X POST "${CONCERTO_CALLBACK_URL}" \
        -H "Content-Type: application/json" \
        -H "X-Callback-Secret: ${TTYD_PASSWORD}" \
        -d "{
          \"token\":         \"${CONCERTO_TOKEN}\",
          \"mcp_url\":       \"${TUNNEL_URL}\",
          \"bearer_token\":  \"${BEARER_TOKEN}\",
          \"ttyd_url\":      \"${TUNNEL_URL}/terminal\"
        }"

      echo "[concerto] Provisioning complete."

  # -- git credentials polling script -----------------------------------------
  # Polls the backend for a GitHub token every 30s for the first 30 min.
  # Runs on BOTH prewarmed and fresh droplets (not inside the prewarmed block).
  - path: /opt/concerto/setup_git_credentials.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      # Pulls stored GitHub token from the Concerto backend and writes it to
      # /root/.git-credentials so the VPS can clone/push private repos.
      # The user connects GitHub AFTER provisioning; this polls until the token
      # appears, then stops the timer once credentials are configured.

      source /etc/concerto/env || exit 0
      source /etc/concerto/ttyd.env || exit 0

      CONCERTO_API_BASE="${CONCERTO_CALLBACK_URL%%/api/*}"
      CREDS_FILE="/root/.git-credentials"

      UPTIME_S=$(awk '{print int($1)}' /proc/uptime 2>/dev/null) || UPTIME_S=0
      if [ "$UPTIME_S" -gt 1800 ]; then
          systemctl stop concerto-git-credentials.timer 2>/dev/null || true
          exit 0
      fi

      if [ -f "$CREDS_FILE" ] && grep -q "github.com" "$CREDS_FILE" 2>/dev/null; then
          systemctl stop concerto-git-credentials.timer 2>/dev/null || true
          exit 0
      fi

      RESPONSE=$(curl -sf -m 10 \
          -H "X-Callback-Secret: ${TTYD_PASSWORD}" \
          "${CONCERTO_API_BASE}/api/buyer/${CONCERTO_TOKEN}/git-credentials" \
          2>/dev/null || echo '{}')

      GITHUB_TOKEN=$(echo "$RESPONSE" | python3 -c \
          "import sys,json; d=json.loads(sys.stdin.read()); print(d.get('github_token',''))" \
          2>/dev/null || true)

      [ -z "${GITHUB_TOKEN:-}" ] && exit 0

      git config --global credential.helper store
      printf 'https://x-access-token:%s@github.com\n' "$GITHUB_TOKEN" > "$CREDS_FILE"
      chmod 600 "$CREDS_FILE"
      echo "[concerto] GitHub git credentials configured."
      systemctl stop concerto-git-credentials.timer 2>/dev/null || true

  # -- systemd: git credentials polling service --------------------------------
  - path: /etc/systemd/system/concerto-git-credentials.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Concerto: pull git credentials from backend
      After=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/opt/concerto/setup_git_credentials.sh

  # -- systemd: git credentials polling timer ----------------------------------
  - path: /etc/systemd/system/concerto-git-credentials.timer
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Concerto: git credentials polling timer

      [Timer]
      OnBootSec=30
      OnUnitActiveSec=30
      Unit=concerto-git-credentials.service

      [Install]
      WantedBy=timers.target

# --- runcmd (runs on first boot as root, sequentially) -----------------------

runcmd:
  # -- 0. Write SSH key FIRST (belt-and-suspenders; ssh_authorized_keys module already ran)
  # NOTE: passwd -l root is intentionally ABSENT -- locking root on Ubuntu 22.04 with
  # UsePAM yes causes PAM to deny even SSH key auth (shadow '!' prefix). DO NOT re-add.
  - ["bash", "-c", "mkdir -p /root/.ssh && chmod 700 /root/.ssh && echo \"{{ ssh_authorized_key }}\" > /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys"]

  # -- 0b. Unprivileged user that runs `claude` (it refuses bypassed
  #        permissions as root). Created always, even on prewarmed images.
  - ["bash", "-c", "id concerto >/dev/null 2>&1 || useradd -m -s /bin/bash concerto; mkdir -p /home/concerto/.claude; chown -R concerto:concerto /home/concerto; chmod 755 /home/concerto"]

{% if not prewarmed|default(false) %}
  # -- 1. System packages (DEBIAN_FRONTEND=noninteractive, lock already released by bootcmd)
  - ["bash", "-c", "DEBIAN_FRONTEND=noninteractive apt-get update -qq"]
  - ["bash", "-c", "DEBIAN_FRONTEND=noninteractive apt-get install -y -o DPkg::Lock::Timeout=120 curl python3-venv tmux git nginx"]

  # -- 1b. ttyd static binary (not in Ubuntu 22.04 apt repos; use official static release)
  - ["bash", "-c", "set -e; for i in 1 2 3; do curl -fsSL https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.x86_64 -o /usr/bin/ttyd && chmod +x /usr/bin/ttyd && break; echo Retry $i; sleep 5; done; test -x /usr/bin/ttyd"]

  # -- 2. Node.js 20 via NodeSource ------------------------------------------
  - ["bash", "-c", "curl -fsSL https://deb.nodesource.com/setup_20.x | bash -"]
  - ["apt-get", "install", "-y", "nodejs"]

  # -- 3. Claude Code CLI ----------------------------------------------------
  - ["npm", "install", "-g", "@anthropic-ai/claude-code"]

  # -- 4. cloudflared (latest .deb release from GitHub) ---------------------
  - ["bash", "-c",
     "curl -fsSL https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb -o /tmp/cloudflared.deb && dpkg -i /tmp/cloudflared.deb"]

  # -- 5. Concerto Python venv + MCP deps ------------------------------------
  - ["bash", "-c",
     "python3 -m venv /opt/concerto/.venv && /opt/concerto/.venv/bin/pip install --quiet --upgrade pip && /opt/concerto/.venv/bin/pip install --quiet 'mcp[cli]>=1.2' anyio fastapi 'uvicorn[standard]'"]
{% endif %}
  # -- 6. Generate MCP bearer token -----------------------------------------
  - ["bash", "-c", "openssl rand -hex 32 > /etc/concerto/token && chmod 600 /etc/concerto/token"]

  # -- 7. Session storage directory ------------------------------------------
  - ["mkdir", "-p", "/var/lib/concerto/sessions"]

  # -- 8. F4: verify SSH authorized_keys before starting services ------------
  # cloud-init ssh_authorized_keys runs before runcmd, so key is already present.
  - ["bash", "-c", "mkdir -p /root/.ssh && chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys 2>/dev/null || true"]


  # -- 9. nginx: disable default site, test config ---------------------------
  - ["bash", "-c", "rm -f /etc/nginx/sites-enabled/default && nginx -t"]

  # -- 10. Prepare cloudflared log file -------------------------------------
  # F5: concerto-tunnel.service appends to this file; pre-create it so
  # provision_complete.sh poll doesn't fail on first iteration.
  - ["bash", "-c", "touch /var/log/cloudflared-quicktunnel.log && chmod 644 /var/log/cloudflared-quicktunnel.log"]

  # -- 11. systemd: reload, enable, start all units --------------------------
  # Start nginx + MCP + ttyd first, then tunnel (which depends on them).
  # F4: SSH is ready (ssh_authorized_keys processed) before we reach here.
  - ["systemctl", "daemon-reload"]
  - ["bash", "-c",
     "systemctl enable concerto-mcp concerto-ttyd concerto-tunnel nginx && systemctl start nginx concerto-mcp concerto-ttyd"]
  # F5: brief pause to let ttyd fully bind before cloudflared starts
  - ["bash", "-c", "sleep 3 && systemctl start concerto-tunnel"]

  # -- 11b. Git credentials polling timer (prewarmed-safe: outside prewarmed block)
  - ["bash", "-c", "systemctl enable concerto-git-credentials.timer && systemctl start concerto-git-credentials.timer"]

  # -- 12. Wait for tunnel URL and POST back to empire backend ---------------
  - ["/opt/concerto/provision_complete.sh"]

  # -- 13. Workspace directory permissions ----------------------------------
  - ["bash", "-c",
     "find /opt/concerto-workspace -type d -exec chmod 755 {} + && find /opt/concerto-workspace -type f -exec chmod 644 {} +"]
  - ["bash", "-c", "chown -R root:root /opt/concerto-workspace"]

  # -- 14. Default working directory when SSH'd in ---------------------------
  - ["bash", "-c",
     "echo 'cd /opt/concerto-workspace' >> /root/.bashrc"]

